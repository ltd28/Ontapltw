@model IEnumerable<LeTienDat_241230697.Models.HangHoa>
<div class="section group">
@foreach (var item in Model)
{
    <div class="grid_1_of_4 images_1_of_4">
        @if (!string.IsNullOrWhiteSpace(item.Anh))
        {
            <img src="~/images/@item.Anh" alt="@item.TenHang" />
        }
        <h2>@item.TenHang</h2>
        <div class="price-details">
            <div class="price-number"><p><span class="rupees">@(item.Gia?.ToString("0") ?? "0")</span></p></div>
            <div class="add-cart"><h4><a href="#">Add to Cart</a></h4></div>
            <div class="clear"></div>
        </div>
    </div>
}
@if (!Model.Any())
{
    <p>Không có hàng hóa phù hợp.</p>
}
</div>
